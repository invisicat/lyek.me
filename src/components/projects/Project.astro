---
import { Icon } from "astro-icon/components";
import BaseButton from "../base/BaseButton.astro";

interface ProjectProps {
  title: string;
  description: string;
  link: string;
  variant: "long" | "short";
  tags?: string[];
  recent?: boolean;
  link_type?: "github" | "website";
}

const props: ProjectProps = {
  variant: "short",
  recent: false,
  link_type: "github",
  ...Astro.props,
} as ProjectProps;
---

<div class={`flex flex-col ${props.variant === "long" ? "md:col-span-2" : ""}`}>
  <div class="flex items-center gap-2 mb-2">
    <BaseButton
      href={props.link}
      class="border-gray-600 hover:border-[oklch(70%_0.123_244.06)]"
      target="_blank"
    >
      {
        props.recent && (
          <Icon
            name="tabler:star-filled"
            width="16"
            height="16"
            class="text-[oklch(0.8485_0.1529_102.18)]"
          />
        )
      }
      <h3 class="text-xl font-semibold border-b border-dotted dark:text-white">
        {props.title}
      </h3>
      {
        props.tags && props.tags.includes("mobile") && (
          <Icon
            name="tabler:device-mobile"
            class="text-[oklch(0.65_0.15_250)]"
            width="20"
            height="20"
          />
        )
      }
      {
        props.link_type === "github" ? (
          <Icon name="tabler:brand-github" width="20" height="20" />
        ) : (
          <Icon name="tabler:arrow-up-right" width="20" height="20" />
        )
      }
    </BaseButton>
  </div>
  <p class="text-ltgray dark:text-gray">{props.description}</p>
</div>
