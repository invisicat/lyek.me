---
interface Props {
  title: string;
  description: string;
  id: string;
}

const { title, description, id } = Astro.props;
---

<section id={id} class="scroll-mt-16">
  <h2 class="text-3xl font-bold mb-2">{title}</h2>
  <p class="text-ltgray dark:text-grayer mb-8">{description}</p>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
    <slot />
  </div>
</section>
