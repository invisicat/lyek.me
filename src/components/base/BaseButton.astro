---
interface Props {
  href?: string;
  class?: string;
  target?: string;
}

const { href, class: className = "", target } = Astro.props;
---

{
  href ? (
    <a
      href={href}
      target={target}
      class={`inline-flex items-center gap-2 text-gray-700 hover:text-[oklch(70%_0.123_244.06)] transition-all duration-300 ease-in-out ${className}`}
    >
      <slot />
    </a>
  ) : (
    <button
      class={`inline-flex items-center gap-2 text-gray-700 hover:text-[oklch(70%_0.123_244.06)] transition-all duration-300 ease-in-out ${className}`}
    >
      <slot />
    </button>
  )
}
