---
import BaseFooter from "../components/base/BaseFooter.astro";
import Sidebar from "../components/base/Sidebar.astro";
import "@fontsource-variable/ibm-plex-sans";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Your site description" />
    <meta name="generator" content={Astro.generator} />
    <title>Andy Lyek</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body
    class="flex flex-col md:flex-row min-h-screen container mx-auto p-4 dark:bg-dark dark:text-white"
  >
    <div class="md:sticky md:top-8 h-fit mb-8 md:mb-0">
      <Sidebar />
    </div>
    <div class="flex flex-col flex-1 md:p-4 md:m-6">
      <section class="flex-1 w-full md:w-2/3">
        <slot />
      </section>
      <BaseFooter />
    </div>
  </body>
</html>
