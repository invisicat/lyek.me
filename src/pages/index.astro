---
import BaseLayout from "../layouts/Layout.astro";
import { Icon } from "astro-icon/components";
import Project from "../components/projects/Project.astro";
import BaseButton from "../components/base/BaseButton.astro";
import { getProjects, type Project as ProjectType } from "../lib/notion";

const projects = (await getProjects()).slice(0, 4);
---

<BaseLayout>
  <div class="flex flex-col">
    <section id="hero" class="flex flex-col gap-4 my-4">
      <h1 class="text-4xl font-bold leading-relaxed">Hello, I'm Andy!</h1>
      <h2 class="text-2xl text-gray-600 text-ltgray dark:text-grayer">
        EE/CS student at Stanford
      </h2>
    </section>
    <section id="about" class="leading-relaxed font-sans flex flex-col gap-5">
      <p>
        I love designing and building backend systems. I make all sorts of
        software, from web, mobile, and desktop apps to backend infrastructures.
      </p>
      <p>
        Currently, I'm building a web app that integrates with low level
        hardware (Arduino) for budget real-time video streaming. You can follow
        with my progress on my GitHub!
      </p>
    </section>
    <section class="my-16">
      <h2 class="text-2xl font-bold mb-8">Projects</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {projects.map((p: ProjectType) => <Project {...p} />)}
      </div>
      <div class="mt-8">
        <BaseButton href="/projects">
          <span class="border-b border-gray-300"> See more projects </span>
          <Icon name="tabler:arrow-right" width="20" height="20" />
        </BaseButton>
      </div>
    </section>
  </div>
</BaseLayout>
