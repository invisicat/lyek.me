---
import BaseLayout from "../layouts/Layout.astro";
import Project from "../components/projects/Project.astro";
import {
  type Project as ProjectProps,
  type ProjectType,
  getProjects,
} from "../lib/notion";
import ProjectSection from "../components/projects/ProjectSection.astro";
import { Icon } from "astro-icon/components";
import BaseButton from "../components/base/BaseButton.astro";

// Mark this page as dynamic so it fetches from Notion at runtime
export const prerender = false;

const projectsList = await getProjects();

const projects = projectsList.sort(
  (a, b) => (b.recent ? 1 : 0) - (a.recent ? 1 : 0)
);

const withProject = (projectType: ProjectType) => {
  return projects.filter(
    (project: ProjectProps) => project.project_type === projectType
  );
};
---

<BaseLayout>
  <!-- Navigation Links -->
  <nav
    class="flex flex-col gap-4 md:flex-row md:gap-8 sticky top-0 py-4 bg-white dark:bg-dark"
  >
    <BaseButton
      href="#general"
      class="text-gray-700 hover:text-gray-900 font-medium"
    >
      General Projects
    </BaseButton>
    <BaseButton
      href="#web"
      class="text-gray-700 hover:text-gray-900 font-medium"
    >
      Web Development
    </BaseButton>
    <BaseButton
      href="#games"
      class="text-gray-700 hover:text-gray-900 font-medium"
    >
      Game Development
    </BaseButton>
  </nav>
  <section id="legend">
    <div>
      <div class="flex items-center gap-4 text-sm my-8 text-gray-600">
        <div class="flex items-center">
          <Icon
            name="tabler:star-filled"
            width="16"
            height="16"
            class="text-[oklch(0.8485_0.1529_102.18)]"
          />
          <span class="ml-1">- Recent projects</span>
        </div>
        <div class="flex items-center">
          <Icon
            name="tabler:device-mobile"
            width="16"
            height="16"
            class="text-[oklch(0.65_0.15_250)]"
          />
          <span class="ml-1">- Mobile projects</span>
        </div>
      </div>
    </div>
  </section>
  <div class="flex flex-col gap-16">
    <ProjectSection
      title="General Projects"
      id="general"
      description="A collection of projects I've created over the years from my hobbies."
    >
      {withProject("general").map((c) => <Project {...c} />)}
    </ProjectSection>
    <ProjectSection
      title="Web Development"
      id="web"
      description="Projects I've built for the web using React, Tailwind, Typescript, and basically any web technologies."
    >
      {withProject("web").map((c) => <Project {...c} />)}
    </ProjectSection>
    <ProjectSection
      title="Game Development"
      id="games"
      description="Mods, plugins, servers, and other game projects that I've worked on."
    >
      {withProject("game").map((c) => <Project {...c} />)}
    </ProjectSection>
  </div>
</BaseLayout>
